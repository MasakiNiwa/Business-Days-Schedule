{
  "name": "business-days-schedule",
  "version": "1.20.0",
  "releaseDate": "2026-11-27",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node --import tsx scripts/build-sw.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "holidays": "node --import tsx scripts/build-holidays.ts",
    "serve:dist": "node --import tsx scripts/serve-dist.ts",
    "e2e": "playwright test",
    "e2e:update": "playwright test --project=update --workers=1",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.2",
    "axe-core": "^4.13.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "description": "営業日を考慮した反復ルール駆動のカレンダー",
  "license": "MIT",
  "dependencies": {
    "ts-fsrs": "6.0.1"
  }
}
